{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "/* SPDX-License-Identifier: GPL-2.0-or-later */",
  "$id": "https://github.com/perara/qemu/blob/raspi4/full-platform/contrib/raspi4/release-manifest-schema-v1.json",
  "title": "QEMU Raspberry Pi 4B/CM4 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "source",
    "claims",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "qemu-rpi4-release-manifest-v1"
    },
    "release": {
      "type": "string",
      "pattern": "^rpi4-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "upstream_baseline"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_baseline": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass1",
        "hil_ready",
        "hil_total"
      ],
      "properties": {
        "pass1": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "hil_ready": {
          "type": "integer",
          "minimum": 0
        },
        "hil_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "media_type": {
            "type": "string",
            "minLength": 3
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
